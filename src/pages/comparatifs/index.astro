---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';
import { formatCategoryLabel } from '../../utils/formatCategory';
import { siteConfig } from '../../config/site.config';

const allProducts = await getCollection('produits');
const categoryContent = await getCollection('categories');

// Map unifiée pour toutes les catégories
const categoryMap = new Map();

for (const cat of categoryContent) {
  const name = cat.data.titre_h1 || formatCategoryLabel(cat.id);
  categoryMap.set(cat.id, {
    slug: cat.id,
    name
  });
}

for (const p of allProducts) {
  for (const rawName of (p.data.categories || [])) {
    const s = slugify(rawName);
    if (!categoryMap.has(s)) {
      categoryMap.set(s, {
        slug: s,
        name: formatCategoryLabel(s)
      });
    }
  }
}

// Calculer le nombre de produits pour chaque catégorie et filtrer les catégories vides
const allCategories = Array.from(categoryMap.values()).filter(cat => {
  return allProducts.some(p => {
    const cats = p.data.categories || [];
    return cats.some(c => slugify(c) === cat.slug || c === cat.slug);
  });
}).sort((a, b) => a.name.localeCompare(b.name));

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Comparatifs", url: "/comparatifs/" }
];

const siteUrl = siteConfig.siteDomain.replace(/\/$/, '');
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `Nos comparatifs de ${siteConfig.siteName}`,
  "description": `Sélectionnez une catégorie pour accéder au top des produits recommandés par nos experts.`,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": allCategories.map((c, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "url": `${siteUrl}/comparatifs/${c.slug}/`,
      "name": c.name
    }))
  }
};
---

<Layout 
  title={`Tous nos Comparatifs : Les Meilleurs Modèles | ${siteConfig.siteName}`}
  description={`Accédez à l'ensemble de nos guides comparatifs par usage et catégorie. Trouvez le meilleur équipement au prix le plus juste.`}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" is:inline slot="extra-head" set:html={JSON.stringify(collectionSchema)} />

  <nav class="flex text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2">
      <li><a href="/" class="hover:text-brand transition-colors">Accueil</a></li>
      <li><span class="mx-1 text-slate-300">/</span></li>
      <li class="font-bold text-slate-900" aria-current="page">Comparatifs</li>
    </ol>
  </nav>

  <header class="mb-10 max-w-3xl">
    <span class="text-xs font-black uppercase tracking-wider text-brand bg-brand-light px-3 py-1 rounded-full inline-block mb-3">
      Guides & Comparatifs
    </span>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mb-3 tracking-tight">
      Nos comparatifs de {siteConfig.siteName}
    </h1>
    <p class="text-base text-slate-600 leading-relaxed">
      Sélectionnez une catégorie ci-dessous pour accéder au top des produits recommandés par nos experts selon vos besoins spécifiques.
    </p>
  </header>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {allCategories.map(cat => (
      <a 
        href={`/comparatifs/${cat.slug}/`}
        class="group bg-white p-8 rounded-3xl border border-slate-200/90 shadow-xs hover:border-brand hover:shadow-md transition-all flex flex-col justify-between"
      >
        <div>
          <div class="inline-flex items-center justify-center w-12 h-12 bg-brand-light text-brand rounded-2xl mb-6 group-hover:bg-brand group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-brand transition-colors">
            {cat.name}
          </h2>
        </div>
        <div class="mt-4 flex items-center text-brand font-bold text-sm">
          Voir le comparatif
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>

  {allCategories.length === 0 && (
    <div class="text-center py-20 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
      <p class="text-slate-500 font-medium italic">Aucune catégorie détectée.</p>
    </div>
  )}
</Layout>
