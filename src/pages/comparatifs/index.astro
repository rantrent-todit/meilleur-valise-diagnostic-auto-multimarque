---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';
import { siteConfig } from '../../config/site.config';

const allProducts = await getCollection('produits');
const categoryContent = await getCollection('categories');

// Map unifiée pour toutes les catégories
const categoryMap = new Map();

for (const cat of categoryContent) {
  const name = cat.data.titre_h1 || (cat.data.titre_seo
    ? cat.data.titre_seo.replace(/^Meilleurs?\s+(modèles\s+)?/i, '').split(':')[0].trim()
    : cat.id.replace(/-/g, ' '));

  categoryMap.set(cat.id, {
    slug: cat.id,
    name,
    description: cat.data.description_seo || `Découvrez notre guide comparatif complet et notre sélection pour ${name}.`
  });
}

for (const p of allProducts) {
  for (const rawName of (p.data.categories || [])) {
    const s = slugify(rawName);
    if (!categoryMap.has(s)) {
      categoryMap.set(s, {
        slug: s,
        name: rawName,
        description: `Découvrez notre sélection des meilleurs modèles pour la catégorie ${rawName}.`
      });
    }
  }
}

// Calculer le nombre de produits pour chaque catégorie et filtrer les catégories vides
const allCategories = Array.from(categoryMap.values()).map(cat => {
  const count = allProducts.filter(p => {
    const cats = p.data.categories || [];
    return cats.some(c => slugify(c) === cat.slug || c === cat.slug);
  }).length;

  return {
    ...cat,
    count
  };
}).filter(cat => cat.count > 0).sort((a, b) => {
  if (b.count !== a.count) return b.count - a.count;
  return a.name.localeCompare(b.name);
});

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Comparatifs", url: "/comparatifs/" }
];

const siteUrl = siteConfig.siteDomain.replace(/\/$/, '');
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Tous nos comparatifs par catégorie",
  "description": "Accédez à nos guides comparatifs par usage et catégorie.",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": allCategories.map((c, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "url": `${siteUrl}/comparatifs/${c.slug}/`,
      "name": c.name
    }))
  }
};
---

<Layout 
  title="Tous nos Comparatifs de Produits : Les Meilleurs Modèles"
  description="Accédez à l'ensemble de nos guides comparatifs par usage et catégorie. Trouvez le meilleur équipement au prix le plus juste."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" is:inline slot="extra-head" set:html={JSON.stringify(collectionSchema)} />

  <nav class="flex text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2">
      <li><a href="/" class="hover:text-orange-600 transition-colors">Accueil</a></li>
      <li><span class="mx-1 text-slate-300">/</span></li>
      <li class="font-bold text-slate-900" aria-current="page">Comparatifs</li>
    </ol>
  </nav>

  <div class="mb-10 max-w-3xl">
    <span class="text-xs font-black uppercase tracking-wider text-orange-600 bg-orange-100 px-3 py-1 rounded-full inline-block mb-3">
      Guides & Comparatifs
    </span>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mb-3 tracking-tight">
      Nos comparatifs de modèles
    </h1>
    <p class="text-base text-slate-600 leading-relaxed">
      Sélectionnez une catégorie pour explorer nos tests comparatifs vérifiés et notre sélection rigoureuse des modèles les plus fiables.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {allCategories.map(cat => (
      <a 
        href={`/comparatifs/${cat.slug}/`}
        class="bg-white border border-slate-200/90 rounded-2xl p-6 hover:border-orange-500 hover:shadow-lg transition-all flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-black text-orange-600 uppercase tracking-wider bg-orange-50 px-2.5 py-1 rounded-md">
              {cat.count} référence{cat.count > 1 ? 's' : ''}
            </span>
          </div>
          <h2 class="font-bold text-xl text-slate-900 group-hover:text-orange-600 capitalize leading-tight mb-2 !my-0">
            {cat.name}
          </h2>
          <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
            {cat.description}
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-extrabold text-orange-600">
          <span>Consulter le comparatif</span>
          <span class="group-hover:translate-x-1 transition-transform font-bold text-base">&rarr;</span>
        </div>
      </a>
    ))}
  </div>
</Layout>
