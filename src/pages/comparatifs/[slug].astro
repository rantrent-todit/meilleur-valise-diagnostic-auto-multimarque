---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlocVerdictTop3 from '../../components/BlocVerdictTop3.astro';
import BadgeConfiance from '../../components/BadgeConfiance.astro';
import { slugify } from '../../utils/slugify';
import { formatCategoryLabel } from '../../utils/formatCategory';

export async function getStaticPaths() {
  const allProducts = await getCollection('produits');
  const categoryContent = await getCollection('categories');

  // Map unifiée par slug pour garantir l'absence de doublons et couvrir 100% des catégories
  const pathsMap = new Map();

  // 1. Ajouter toutes les catégories déclarées dans content/categories
  for (const cat of categoryContent) {
    const slug = cat.id;
    const name = cat.data.titre_h1 || (cat.data.titre_seo
      ? cat.data.titre_seo.replace(/^Meilleurs?\s+(modèles\s+)?/i, '').split(':')[0].trim()
      : formatCategoryLabel(cat.id));

    pathsMap.set(slug, {
      slug,
      categoryName: name,
      content: cat
    });
  }

  // 2. Ajouter d'éventuelles catégories présentes dans les produits
  for (const p of allProducts) {
    for (const rawCat of (p.data.categories || [])) {
      const s = slugify(rawCat);
      if (!pathsMap.has(s)) {
        pathsMap.set(s, {
          slug: s,
          categoryName: formatCategoryLabel(s),
          content: null
        });
      }
    }
  }

  // 3. Associer les produits à chaque catégorie avec un matching robuste
  return Array.from(pathsMap.values()).map(catEntry => {
    const products = allProducts.filter(p => {
      const pCats = p.data.categories || [];
      return pCats.some(c => slugify(c) === catEntry.slug || c === catEntry.slug);
    });

    return {
      params: { slug: catEntry.slug },
      props: {
        categoryName: catEntry.categoryName,
        products,
        content: catEntry.content,
        slug: catEntry.slug
      }
    };
  }).filter(pathItem => pathItem.props.products.length > 0);
}

const { categoryName, products = [], content, slug } = Astro.props;
const Content = content ? (await render(content)).Content : null;

// Algorithme de scoring de conversion Top 3 : Marque + Prix sérieux + Volume Avis + Note
const scoredProducts = products.map(p => {
  let score = 0;
  const title = (p.data.titre || '').trim();
  const firstWord = title.split(' ')[0] || '';
  const isGeneric = /^(inverter|convertisseur|poste|raboteuse|decoupeur|scooter|valise|controleur|remontoir|jumelle)/i.test(firstWord);

  // 1. Bonus Marque détectée (+500 pts)
  if (!isGeneric && firstWord.length > 2) {
    score += 500;
  }

  // 2. Bonus Panier sérieux (> 80 € : +200 pts, gadget < 50 € : -150 pts)
  const prixNum = parseFloat((p.data.prix || '0').replace(',', '.'));
  if (prixNum >= 80) {
    score += 200;
  } else if (prixNum > 0 && prixNum < 50) {
    score -= 150;
  }

  // 3. Bonus Preuve Sociale (Volume total d'avis clients)
  const totalAvis = p.data.satisfaction_globale?.total_avis || 0;
  score += Math.min(Math.log10(Math.max(totalAvis, 1)) * 100, 350);

  // 4. Bonus Note de satisfaction client
  const note = p.data.satisfaction_globale?.note_moyenne || 4.0;
  score += (note - 4.0) * 200;

  return { produit: p, score };
});

const sortedScored = [...scoredProducts].sort((a, b) => b.score - a.score);
const top3Products = sortedScored.slice(0, 3).map(item => item.produit);

// SEO Title (sans branding parasite ni dates)
let seoTitle = content?.data.titre_seo || `Meilleurs modèles ${categoryName} : Guide et Comparatif`;
seoTitle = seoTitle.replace(/\s*\|\s*.*$/i, '').replace(/\b202[0-9]\b/g, '').replace(/\s+/g, ' ').trim();
if (!seoTitle.toLowerCase().startsWith('meilleur')) {
  seoTitle = `Meilleurs modèles ${seoTitle} : Guide et Comparatif`;
}
if (seoTitle.length > 90) seoTitle = seoTitle.slice(0, 87) + '...';

// H1 Lisible et percutant
const pageHeading = content?.data.titre_h1 || (categoryName.toLowerCase().startsWith('meilleur') 
  ? categoryName 
  : `Comparatif : ${categoryName}`);

let seoDescription = content?.data.description_seo || `Découvrez notre comparatif complet et sélection pour ${categoryName}. Analyse technique, tests et conseils d'experts.`;
seoDescription = seoDescription.replace(/\b202[0-9]\b/g, '').replace(/\s+/g, ' ').trim();
if (seoDescription.length < 80) {
  const supplement = ` Guide d'achat complet.`;
  if ((seoDescription + supplement).length <= 150) {
    seoDescription += supplement;
  }
}
if (seoDescription.length > 165) {
  const truncated = seoDescription.slice(0, 160);
  const lastSpace = truncated.lastIndexOf(' ');
  seoDescription = (lastSpace > 120 ? truncated.slice(0, lastSpace) : truncated) + '...';
}

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Comparatifs", url: "/comparatifs/" },
  { name: categoryName, url: `/comparatifs/${slug}/` }
];

// Schema ItemList pour le podium
const itemListJsonLd = top3Products.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Top 3 ${categoryName}`,
  "numberOfItems": top3Products.length,
  "itemListElement": top3Products.map((p, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": p.data.titre,
    "url": `/avis/${p.id}/`
  }))
} : null;
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={breadcrumbs}
>
  {itemListJsonLd && (
    <script type="application/ld+json" is:inline slot="extra-head" set:html={JSON.stringify(itemListJsonLd)} />
  )}
  {content?.data.faq && content.data.faq.length > 0 && (
    <script type="application/ld+json" is:inline slot="extra-head" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": content.data.faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.r
        }
      }))
    })} />
  )}

  <nav class="flex text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2">
      <li><a href="/" class="hover:text-brand transition-colors">Accueil</a></li>
      <li><span class="mx-1 text-slate-300">/</span></li>
      <li><a href="/comparatifs/" class="hover:text-brand transition-colors">Comparatifs</a></li>
      <li><span class="mx-1 text-slate-300">/</span></li>
      <li class="font-bold text-slate-900 truncate capitalize" aria-current="page">{categoryName}</li>
    </ol>
  </nav>

  <header class="mb-8 max-w-4xl">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-light border border-brand/20 text-brand text-[11px] sm:text-xs font-black uppercase tracking-wider mb-3">
      <svg class="w-3.5 h-3.5 text-brand" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
      </svg>
      Comparatif Spécialisé & Tests Vérifiés
    </div>
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight leading-tight capitalize !my-0">
      {pageHeading}
    </h1>
    <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
      {seoDescription}
    </p>
  </header>

  <!-- PODIUM TOP 3 EXCLUSIF DE CONVERSION -->
  {top3Products.length >= 2 && (
    <BlocVerdictTop3 
      produits={top3Products}
      titre={`Podium : ${categoryName}`}
      sousTitre="Les modèles incontournables sélectionnés pour leur fiabilité, performance et satisfaction client vérifiée"
    />
  )}

  <!-- BADGE DE RÉASSURANCE -->
  <BadgeConfiance titre="Notre Protocole d'Évaluation Indépendant" />

  <!-- GUIDE D'ACHAT DÉTAILLÉ DE LA CATÉGORIE -->
  {content && (
    <section class="bg-white p-6 sm:p-10 rounded-3xl border border-gray-200 shadow-sm my-12">
      <div class="prose prose-slate prose-lg max-w-none">
        <Content />
      </div>
    </section>
  )}

  <!-- FAQ DE LA CATÉGORIE (SCHEMA.ORG FAQPAGE) -->
  {content?.data.faq && content.data.faq.length > 0 && (
    <section class="my-16">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="text-xs font-black uppercase tracking-wider text-brand bg-brand-light px-3 py-1 rounded-full inline-block mb-3">
            Questions Fréquentes
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight !my-0">
            Foire aux questions sur {categoryName}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2">
            Les réponses clés de nos experts pour faire le meilleur investissement.
          </p>
        </div>

        <div class="space-y-4">
          {content.data.faq.map((item, idx) => (
            <details class="group bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-6 transition-all [&_summary::-webkit-details-marker]:hidden open:border-brand open:shadow-sm">
              <summary class="flex items-center justify-between cursor-pointer font-extrabold text-slate-900 text-sm sm:text-base select-none">
                <span class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-full bg-brand-light text-brand font-black text-xs flex items-center justify-center flex-shrink-0">
                    {idx + 1}
                  </span>
                  {item.q}
                </span>
                <span class="w-6 h-6 flex items-center justify-center text-slate-400 group-open:text-brand group-open:rotate-180 transition-transform">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 pt-4 border-t border-slate-100 text-xs sm:text-sm text-slate-600 leading-relaxed pl-9">
                {item.r}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
