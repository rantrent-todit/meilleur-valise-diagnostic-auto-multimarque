---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CarteApercu from '../../components/CarteApercu.astro';
import TableauComparatif from '../../components/TableauComparatif.astro';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
  const allProducts = await getCollection('produits');
  const categoryContent = await getCollection('categories');

  // Map unifiée par slug pour garantir l'absence de doublons et couvrir 100% des catégories
  const pathsMap = new Map();

  // 1. Ajouter toutes les catégories déclarées dans content/categories
  for (const cat of categoryContent) {
    const slug = cat.id;
    const name = cat.data.titre_h1 || (cat.data.titre_seo
      ? cat.data.titre_seo.replace(/^Meilleurs?\s+(modèles\s+)?/i, '').split(':')[0].trim()
      : cat.id.replace(/-/g, ' '));

    pathsMap.set(slug, {
      slug,
      categoryName: name,
      content: cat
    });
  }

  // 2. Ajouter d'éventuelles catégories présentes dans les produits
  for (const p of allProducts) {
    for (const rawCat of (p.data.categories || [])) {
      const s = slugify(rawCat);
      if (!pathsMap.has(s)) {
        pathsMap.set(s, {
          slug: s,
          categoryName: rawCat,
          content: null
        });
      }
    }
  }

  // 3. Associer les produits à chaque catégorie avec un matching robuste
  return Array.from(pathsMap.values()).map(catEntry => {
    const products = allProducts.filter(p => {
      const pCats = p.data.categories || [];
      return pCats.some(c => slugify(c) === catEntry.slug || c === catEntry.slug);
    });

    return {
      params: { slug: catEntry.slug },
      props: {
        categoryName: catEntry.categoryName,
        products,
        content: catEntry.content,
        slug: catEntry.slug
      }
    };
  }).filter(pathItem => pathItem.props.products.length > 0);
}

const { categoryName, products = [], content, slug } = Astro.props;
const Content = content ? (await render(content)).Content : null;

// SEO Title (pour la balise <title> SERP, sans aucun branding parasite)
let seoTitle = content?.data.titre_seo || `Meilleurs modèles ${categoryName} : Guide et Comparatif`;
seoTitle = seoTitle.replace(/\s*\|\s*.*$/i, '').replace(/\b202[0-9]\b/g, '').replace(/\s+/g, ' ').trim();
if (!seoTitle.toLowerCase().startsWith('meilleur')) {
  seoTitle = `Meilleurs modèles ${seoTitle} : Guide et Comparatif`;
}
if (seoTitle.length > 90) seoTitle = seoTitle.slice(0, 87) + '...';

// H1 Lisible, percutant et sans branding
const pageHeading = content?.data.titre_h1 || (categoryName.toLowerCase().startsWith('meilleur') 
  ? categoryName 
  : `Comparatif : ${categoryName}`);

let seoDescription = content?.data.description_seo || `Découvrez notre comparatif complet et sélection pour ${categoryName}. Analyse technique, tests et conseils d'experts.`;
seoDescription = seoDescription.replace(/\b202[0-9]\b/g, '').replace(/\s+/g, ' ').trim();
if (seoDescription.length < 80) {
  const supplement = ` Guide d'achat complet.`;
  if ((seoDescription + supplement).length <= 150) {
    seoDescription += supplement;
  }
}
if (seoDescription.length > 165) {
  const truncated = seoDescription.slice(0, 160);
  const lastSpace = truncated.lastIndexOf(' ');
  seoDescription = (lastSpace > 120 ? truncated.slice(0, lastSpace) : truncated) + '...';
}

const breadcrumbs = [
  { name: "Accueil", url: "/" },
  { name: "Comparatifs", url: "/comparatifs/" },
  { name: categoryName, url: `/comparatifs/${slug}/` }
];
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  breadcrumbs={breadcrumbs}
>
  {content?.data.faq && content.data.faq.length > 0 && (
    <script type="application/ld+json" is:inline slot="extra-head" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": content.data.faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.r
        }
      }))
    })} />
  )}

  <nav class="flex text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2">
      <li><a href="/" class="hover:text-orange-600 transition-colors">Accueil</a></li>
      <li><span class="mx-1 text-slate-300">/</span></li>
      <li><a href="/comparatifs/" class="hover:text-orange-600 transition-colors">Comparatifs</a></li>
      <li><span class="mx-1 text-slate-300">/</span></li>
      <li class="font-bold text-slate-900 truncate capitalize" aria-current="page">{categoryName}</li>
    </ol>
  </nav>

  <header class="mb-10 max-w-4xl">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-100 border border-orange-200 text-orange-800 text-xs font-black uppercase tracking-wider mb-4">
      <svg class="w-4 h-4 text-orange-600" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
      </svg>
      Comparatif Spécialisé & Tests Vérifiés
    </div>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight capitalize !my-0">
      {pageHeading}
    </h1>
    <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
      Tests comparatifs vérifiés et guide de sélection pour vous équiper avec le modèle le plus adapté à vos attentes.
    </p>
  </header>

  {products.length > 0 && (
    <TableauComparatif 
      produits={products}
      limit={3}
      titreSection={`Tableau Comparatif : Top 3 ${categoryName}`}
      sousTitreSection="Les 3 modèles les plus convaincants de la catégorie selon nos tests vérifiés"
    />
  )}

  {content && (
    <section class="bg-white p-6 sm:p-10 rounded-3xl border border-gray-200 shadow-sm my-12">
      <div class="prose prose-slate prose-lg max-w-none">
        <Content />
      </div>
    </section>
  )}

  {products.length > 0 ? (
    <section class="my-14">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-gray-200">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight !my-0 capitalize">
            Tous les modèles retenus en {categoryName}
          </h2>
          <p class="text-xs text-slate-500 mt-1">Fiches techniques détaillées et avis vérifiés d'experts</p>
        </div>
        <span class="text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
          {products.length} référence{products.length > 1 ? 's' : ''}
        </span>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map((product, idx) => (
          <CarteApercu 
            titre={product.data.titre}
            description={product.data.description_courte}
            image={product.data.image_url}
            slug={product.id}
            lienAffiliation={product.data.lien_affiliation}
            categories={product.data.categories}
            index={idx}
          />
        ))}
      </div>
    </section>
  ) : (
    <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-300">
      <p class="text-slate-500 font-medium">Aucun produit n'est actuellement associé à cette catégorie.</p>
    </div>
  )}

  <!-- FAQ DE LA CATÉGORIE (SCHEMA.ORG FAQPAGE) -->
  {content?.data.faq && content.data.faq.length > 0 && (
    <section class="my-16">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="text-xs font-black uppercase tracking-wider text-orange-600 bg-orange-100 px-3 py-1 rounded-full inline-block mb-3">
            Questions Fréquentes
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight !my-0">
            Foire aux questions sur {categoryName}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2">
            Les réponses clés de nos experts pour faire le meilleur investissement.
          </p>
        </div>

        <div class="space-y-4">
          {content.data.faq.map((item, idx) => (
            <details class="group bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-6 transition-all [&_summary::-webkit-details-marker]:hidden open:border-orange-500 open:shadow-sm">
              <summary class="flex items-center justify-between cursor-pointer font-extrabold text-slate-900 text-sm sm:text-base select-none">
                <span class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-full bg-orange-100 text-orange-700 font-black text-xs flex items-center justify-center flex-shrink-0">
                    {idx + 1}
                  </span>
                  {item.q}
                </span>
                <span class="w-6 h-6 flex items-center justify-center text-slate-400 group-open:text-orange-600 group-open:rotate-180 transition-transform">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 pt-4 border-t border-slate-100 text-xs sm:text-sm text-slate-600 leading-relaxed pl-9">
                {item.r}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
