---
interface Props {
  titre?: string;
}

const { titre = "Notre Protocole d'Évaluation Optique" } = Astro.props;

const piliers = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`,
    nom: "Transmission Lumineuse",
    desc: "Vérification des prismes (BaK-4 vs BK-7) et des couches antireflets multicouches intégrales (FMC) en basse lumière."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
    nom: "Étanchéité & Robustesse",
    desc: "Contrôle de la résistance aux intempéries (normes IPX6/IPX7) et du remplissage d'azote antibuée interne."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    nom: "Confort & Dégagement",
    desc: "Mesure du relief d'œil pour porteurs de lunettes, fluidité de la molette centrale et ergonomie de préhension."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />`,
    nom: "Neutralité Éditoriale",
    desc: "Sélections rigoureuses sans rémunération des marques : nos recommandations sont guidées uniquement par les performances réelles."
  }
];
---

<section class="my-16 bg-slate-900 text-white rounded-3xl p-8 sm:p-12 shadow-xl relative overflow-hidden">
  <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-orange-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-3xl mb-10">
    <span class="inline-block text-xs font-black uppercase tracking-wider bg-orange-500/20 text-orange-400 border border-orange-400/30 px-3 py-1 rounded-full mb-3">
      Exigence & Rigueur Technique
    </span>
    <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight !my-0">
      {titre}
    </h2>
    <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
      Chaque paire de jumelles mentionnée sur notre guide fait l'objet d'un examen minutieux selon 4 critères techniques fondamentaux.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {piliers.map((pilier, idx) => (
      <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-5 hover:border-slate-600 transition-colors">
        <div class="w-10 h-10 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={pilier.icon} />
        </div>
        <div class="text-xs font-black text-orange-400 mb-1">0{idx + 1}</div>
        <h3 class="text-base font-bold text-white mb-2 !my-0">{pilier.nom}</h3>
        <p class="text-xs text-slate-400 leading-relaxed mt-1">
          {pilier.desc}
        </p>
      </div>
    ))}
  </div>
</section>
