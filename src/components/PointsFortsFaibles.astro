---
import { formatInlineText } from '../utils/formatMarkdown';

interface Props {
  pointsForts: string[];
  pointsFaibles: string[];
}

const { pointsForts = [], pointsFaibles = [] } = Astro.props;
---

<div class="my-8 grid md:grid-cols-2 gap-6">
  <!-- Points Forts -->
  <div class="bg-emerald-50/70 border border-emerald-200/80 rounded-2xl p-6 shadow-sm">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="text-lg font-extrabold text-emerald-950 !my-0">Ce qu'on apprécie (Points Forts)</h3>
    </div>
    <ul class="space-y-2.5">
      {pointsForts.map(point => (
        <li class="flex items-start text-sm text-emerald-900 leading-snug">
          <span class="text-emerald-600 font-bold mr-2 text-base leading-none">✓</span>
          <span set:html={formatInlineText(point, "font-bold text-emerald-950")} />
        </li>
      ))}
    </ul>
  </div>

  <!-- Points Faibles -->
  <div class="bg-rose-50/70 border border-rose-200/80 rounded-2xl p-6 shadow-sm">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-sm shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="text-lg font-extrabold text-rose-950 !my-0">À prendre en compte (Limites)</h3>
    </div>
    <ul class="space-y-2.5">
      {pointsFaibles.map(point => (
        <li class="flex items-start text-sm text-rose-900 leading-snug">
          <span class="text-rose-600 font-bold mr-2 text-base leading-none">✕</span>
          <span set:html={formatInlineText(point, "font-bold text-rose-950")} />
        </li>
      ))}
    </ul>
  </div>
</div>
