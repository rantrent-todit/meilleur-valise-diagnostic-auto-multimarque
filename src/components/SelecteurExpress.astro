---
import { slugify } from '../utils/slugify';

interface ProductItem {
  id: string;
  data: {
    titre: string;
    description_courte: string;
    image_url: string;
    lien_affiliation: string;
    categories: string[];
  };
}

interface Props {
  produits: ProductItem[];
  categories: { slug: string; name: string }[];
}

const { produits = [], categories = [] } = Astro.props;
const sampleCategories = categories.slice(0, 6);
const firstProduct = produits[0];

// Sérialisation propre pour le client JS
const productsJson = JSON.stringify(
  produits.map(p => ({
    id: p.id,
    titre: p.data.titre,
    description: p.data.description_courte,
    image: p.data.image_url,
    lien: p.data.lien_affiliation,
    categories: p.data.categories || []
  }))
);
---

{firstProduct && (
  <section class="my-10 bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100">
      <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-orange-100 text-orange-800">
          <span class="w-2 h-2 rounded-full bg-orange-600 animate-pulse"></span>
          Guide Express en 2 Clics
        </span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mt-2 !my-0">
          Trouvez votre équipement idéal sans hésiter
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Sélectionnez votre pratique et découvrez instantanément notre sélection vérifiée N°1 recommandée.
        </p>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div>
          <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-2.5">
            1. Quel est votre usage principal ?
          </label>
          <div class="flex flex-wrap gap-2" id="selector-usage-group">
            {sampleCategories.map((cat, idx) => (
              <button 
                type="button"
                class={`usage-btn text-xs font-bold px-3.5 py-2 rounded-xl border transition-all cursor-pointer ${idx === 0 ? 'bg-slate-900 text-white border-slate-900 shadow-sm' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-slate-400'}`}
                data-cat-slug={cat.slug}
                data-cat-name={cat.name}
              >
                {cat.name}
              </button>
            ))}
          </div>
        </div>

        <div>
          <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-2.5">
            2. Votre critère prioritaire :
          </label>
          <div class="flex flex-wrap gap-2" id="selector-priority-group">
            <button type="button" class="priority-btn text-xs font-bold px-3.5 py-2 rounded-xl border bg-orange-50 text-orange-800 border-orange-300 transition-all cursor-pointer" data-priority="qp">
              ⭐ Meilleur rapport Qualité / Prix
            </button>
            <button type="button" class="priority-btn text-xs font-bold px-3.5 py-2 rounded-xl border bg-slate-50 text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer" data-priority="pro">
              💎 Performance & Précision
            </button>
            <button type="button" class="priority-btn text-xs font-bold px-3.5 py-2 rounded-xl border bg-slate-50 text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer" data-priority="compact">
              ⚡ Compacité & Légèreté
            </button>
          </div>
        </div>
      </div>

      <!-- Carte Recommandation Express Dynamique -->
      <div class="lg:col-span-5 bg-gradient-to-b from-stone-50 to-white border border-slate-200 rounded-2xl p-5 shadow-sm" id="selector-result-card">
        <div class="flex items-center justify-between text-xs mb-3">
          <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full" id="selector-result-badge">
            Recommandé pour votre profil
          </span>
          <span class="text-[11px] font-bold text-slate-500">Sélection ciblée</span>
        </div>

        <div class="w-full h-36 bg-white border border-slate-100 rounded-xl p-3 flex items-center justify-center mb-3">
          <img id="selector-result-img" src={firstProduct.data.image_url} alt={firstProduct.data.titre} class="max-h-full max-w-full object-contain" />
        </div>

        <h3 id="selector-result-title" class="font-extrabold text-sm sm:text-base text-slate-900 line-clamp-1 leading-snug !my-0">
          {firstProduct.data.titre}
        </h3>
        <p id="selector-result-desc" class="text-xs text-slate-500 line-clamp-2 mt-1 mb-4 leading-relaxed">
          {firstProduct.data.description_courte}
        </p>

        <div class="flex items-center gap-2">
          <a id="selector-result-review" href={`/avis/${firstProduct.id}/`} class="text-xs font-extrabold text-slate-700 hover:text-orange-600 bg-slate-100 hover:bg-slate-200 px-3.5 py-2.5 rounded-xl transition-colors whitespace-nowrap">
            Lire le test
          </a>
          <a id="selector-result-affiliate" href={firstProduct.data.lien_affiliation} target="_blank" rel="sponsored nofollow noopener noreferrer" class="flex-1 text-center text-xs font-black text-white bg-orange-600 hover:bg-orange-700 px-4 py-2.5 rounded-xl shadow-md transition-all whitespace-nowrap">
            Vérifier le prix &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<script is:inline define:vars={{ productsData: productsJson }}>
  (function() {
    let products = [];
    try {
      products = typeof productsData === 'string' ? JSON.parse(productsData) : (productsData || []);
    } catch (e) {
      return;
    }
    if (!products || products.length === 0) return;

    const usageBtns = document.querySelectorAll('.usage-btn');
    const priorityBtns = document.querySelectorAll('.priority-btn');
    const imgEl = document.getElementById('selector-result-img');
    const titleEl = document.getElementById('selector-result-title');
    const descEl = document.getElementById('selector-result-desc');
    const reviewEl = document.getElementById('selector-result-review');
    const affEl = document.getElementById('selector-result-affiliate');

    let currentCat = usageBtns[0]?.dataset.catSlug || '';
    let currentCatName = usageBtns[0]?.dataset.catName || '';

    function updateCard() {
      // Trouver un produit dont une des catégories correspond
      const normalizedCat = currentCat.toLowerCase().replace(/-/g, ' ');
      let found = products.find(p => 
        p.categories && p.categories.some(c => {
          const norm = c.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
          return norm.includes(normalizedCat) || normalizedCat.includes(norm);
        })
      );
      if (!found) found = products[0];
      if (!found) return;

      if (imgEl) {
        imgEl.src = found.image;
        imgEl.alt = found.titre;
      }
      if (titleEl) titleEl.textContent = found.titre;
      if (descEl) descEl.textContent = found.description;
      if (reviewEl) reviewEl.href = `/avis/${found.id}/`;
      if (affEl) affEl.href = found.lien;
    }

    usageBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        usageBtns.forEach(b => {
          b.className = 'usage-btn text-xs font-bold px-3.5 py-2 rounded-xl border bg-slate-50 text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer';
        });
        btn.className = 'usage-btn text-xs font-bold px-3.5 py-2 rounded-xl border bg-slate-900 text-white border-slate-900 shadow-sm transition-all cursor-pointer';
        currentCat = btn.dataset.catSlug || '';
        currentCatName = btn.dataset.catName || '';
        updateCard();
      });
    });

    priorityBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        priorityBtns.forEach(b => {
          b.className = 'priority-btn text-xs font-bold px-3.5 py-2 rounded-xl border bg-slate-50 text-slate-700 border-slate-200 hover:border-slate-400 transition-all cursor-pointer';
        });
        btn.className = 'priority-btn text-xs font-bold px-3.5 py-2 rounded-xl border bg-orange-50 text-orange-800 border-orange-300 transition-all cursor-pointer';
        updateCard();
      });
    });
  })();
</script>
