---
import BoutonAmazon from './BoutonAmazon.astro';

interface ProductItem {
  id: string;
  data: {
    titre: string;
    description_courte: string;
    image_url: string;
    lien_affiliation: string;
    categories: string[];
  };
}

interface Props {
  produits: ProductItem[];
  titre?: string;
  sousTitre?: string;
}

const { 
  produits = [],
  titre = "Le Podium : Les 3 Modèles Recommandés par la Rédaction",
  sousTitre = "Pour ceux qui veulent faire le bon choix immédiatement sans hésiter"
} = Astro.props;

const top3 = produits.slice(0, 3);
if (top3.length === 0) return null;

const winner = top3[0];
const second = top3[1] || top3[0];
const third = top3[2] || top3[0];
---

<div class="my-14 bg-white border border-slate-200/90 p-6 sm:p-10 rounded-3xl shadow-sm">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
      Verdict Immédiat de la Rédaction
    </span>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight !my-0">
      {titre}
    </h2>
    <p class="text-slate-600 text-sm sm:text-base mt-2">
      {sousTitre}
    </p>
  </div>

  <div class="grid lg:grid-cols-3 gap-6 items-stretch">
    <!-- N°2 : Rapport Qualité / Prix (À gauche sur Desktop) -->
    {second && (
      <div class="bg-slate-50/60 rounded-2xl border border-slate-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow order-2 lg:order-1">
        <div>
          <div class="flex items-center justify-between gap-1.5 mb-4">
            <span class="text-[11px] sm:text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full whitespace-nowrap">
              🥈 Rapport Qualité-Prix
            </span>
            <span class="text-[10px] sm:text-[11px] font-bold text-emerald-800 whitespace-nowrap">Compromis Idéal</span>
          </div>
          
          <div class="w-full h-44 bg-white rounded-xl p-3 flex items-center justify-center mb-5 overflow-hidden border border-slate-100">
            <img src={second.data.image_url} alt={second.data.titre} class="w-full h-full object-contain" loading="lazy" />
          </div>

          <h3 class="font-extrabold text-lg text-slate-900 mb-2 leading-snug !my-0">
            <a href={`/avis/${second.id}/`} class="hover:text-brand transition-colors">
              {second.data.titre}
            </a>
          </h3>

          <p class="text-xs text-slate-600 mb-4 line-clamp-3 leading-relaxed mt-2">
            {second.data.description_courte}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-200 mt-4 space-y-3">
          <BoutonAmazon 
            href={second.data.lien_affiliation} 
            variant="compact"
            texte="Voir le prix Amazon"
            class="w-full"
          />
          <a 
            href={`/avis/${second.id}/`} 
            class="block text-center text-xs font-bold text-slate-600 hover:text-brand transition-colors"
          >
            Lire l'avis complet →
          </a>
        </div>
      </div>
    )}

    <!-- N°1 : Le Grand Gagnant (Au centre, mis en valeur Bento) -->
    {winner && (
      <div class="bg-white rounded-3xl border-2 border-brand p-6 sm:p-7 flex flex-col justify-between shadow-xl relative order-1 lg:order-2 lg:-translate-y-2">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-brand to-brand-accent text-white text-[11px] font-black uppercase tracking-widest px-4 py-1 rounded-full shadow-md whitespace-nowrap">
          🏆 Meilleur Choix Global
        </div>

        <div>
          <div class="flex items-center justify-between gap-2 mb-4 mt-2">
            <span class="text-[11px] sm:text-xs font-black uppercase tracking-wider text-brand whitespace-nowrap">
              🏆 N°1 de nos tests
            </span>
            <span class="text-[10px] sm:text-[11px] font-black text-brand uppercase tracking-wider whitespace-nowrap">Coup de Cœur</span>
          </div>

          <div class="w-full h-48 bg-stone-50/50 rounded-2xl p-4 flex items-center justify-center mb-5 overflow-hidden border border-slate-100">
            <img src={winner.data.image_url} alt={winner.data.titre} class="w-full h-full object-contain" loading="lazy" />
          </div>

          <h3 class="font-black text-xl text-slate-900 mb-2 leading-snug !my-0">
            <a href={`/avis/${winner.id}/`} class="hover:text-brand transition-colors">
              {winner.data.titre}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed mt-2">
            {winner.data.description_courte}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100 space-y-3">
          <BoutonAmazon 
            href={winner.data.lien_affiliation} 
            variant="winner"
            texte="Vérifier le meilleur prix"
            sousTexte="Offre officielle Amazon • Stock vérifié"
            class="w-full"
          />
          <a 
            href={`/avis/${winner.id}/`} 
            class="block text-center text-xs font-bold text-slate-700 hover:text-brand transition-colors"
          >
            Consulter notre avis vérifié détaillé →
          </a>
        </div>
      </div>
    )}

    <!-- N°3 : Le Choix Expert (À droite sur Desktop) -->
    {third && (
      <div class="bg-slate-50/60 rounded-2xl border border-slate-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow order-3">
        <div>
          <div class="flex items-center justify-between gap-1.5 mb-4">
            <span class="text-[11px] sm:text-xs font-black uppercase tracking-wider bg-slate-900 text-white px-2.5 py-1 rounded-full whitespace-nowrap">
              🥉 Choix Haut de Gamme
            </span>
            <span class="text-[10px] sm:text-[11px] font-bold text-slate-700 whitespace-nowrap">Finition Supérieure</span>
          </div>

          <div class="w-full h-44 bg-white rounded-xl p-3 flex items-center justify-center mb-5 overflow-hidden border border-slate-100">
            <img src={third.data.image_url} alt={third.data.titre} class="w-full h-full object-contain" loading="lazy" />
          </div>

          <h3 class="font-extrabold text-lg text-slate-900 mb-2 leading-snug !my-0">
            <a href={`/avis/${third.id}/`} class="hover:text-brand transition-colors">
              {third.data.titre}
            </a>
          </h3>

          <p class="text-xs text-slate-600 mb-4 line-clamp-3 leading-relaxed mt-2">
            {third.data.description_courte}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-200 mt-4 space-y-3">
          <BoutonAmazon 
            href={third.data.lien_affiliation} 
            variant="compact"
            texte="Voir le prix Amazon"
            class="w-full"
          />
          <a 
            href={`/avis/${third.id}/`} 
            class="block text-center text-xs font-bold text-slate-600 hover:text-brand transition-colors"
          >
            Lire l'avis complet →
          </a>
        </div>
      </div>
    )}
  </div>
</div>
