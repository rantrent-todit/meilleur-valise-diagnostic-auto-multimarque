---
import BoutonAmazon from './BoutonAmazon.astro';

interface ProductItem {
  id: string;
  data: {
    titre: string;
    description_courte: string;
    image_url: string;
    lien_affiliation: string;
    categories: string[];
  };
}

interface Props {
  produits: ProductItem[];
  titre?: string;
  sousTitre?: string;
}

const { 
  produits = [],
  titre = "Le Podium : Les 3 Modèles Recommandés par la Rédaction",
  sousTitre = "Pour ceux qui veulent faire le bon choix immédiatement sans hésiter"
} = Astro.props;

const top3 = produits.slice(0, 3);
if (top3.length === 0) return null;

const winner = top3[0];
const second = top3[1] || top3[0];
const third = top3[2] || top3[0];
---

<section class="my-14">
  <!-- En-tête de section centré -->
  <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 mb-2">
      <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
      Verdict Immédiat de la Rédaction
    </span>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight !my-0">
      {titre}
    </h2>
    <p class="text-slate-600 text-sm sm:text-base mt-2">
      {sousTitre}
    </p>
  </div>

  <!-- Grille épurée 3 colonnes -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
    <!-- N°1 : Le Grand Gagnant -->
    {winner && (
      <div class="bg-white rounded-2xl border-2 border-brand p-6 flex flex-col justify-between shadow-md hover:shadow-xl transition-all">
        <div>
          <div class="flex items-center justify-center gap-2 mb-4">
            <span class="text-xs font-black uppercase tracking-wider bg-brand text-white px-3 py-1 rounded-full whitespace-nowrap shadow-xs">
              🏆 N°1 • Meilleur Choix
            </span>
            <span class="text-xs font-bold text-brand uppercase tracking-wider whitespace-nowrap">
              Coup de Cœur
            </span>
          </div>

          <div class="w-full h-48 bg-slate-50/70 rounded-xl p-3 flex items-center justify-center mb-5 overflow-hidden border border-slate-100">
            <img src={winner.data.image_url} alt={winner.data.titre} class="w-full h-full object-contain" loading="lazy" />
          </div>

          <h3 class="font-extrabold text-lg sm:text-xl text-slate-900 mb-2 leading-snug !my-0 text-center line-clamp-2">
            <a href={`/avis/${winner.id}/`} class="hover:text-brand transition-colors">
              {winner.data.titre}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed text-center line-clamp-3 mt-2">
            {winner.data.description_courte}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100 space-y-3">
          <BoutonAmazon 
            href={winner.data.lien_affiliation} 
            variant="winner"
            texte="Vérifier le meilleur prix"
            class="w-full"
          />
          <a 
            href={`/avis/${winner.id}/`} 
            class="block text-center text-xs font-bold text-slate-700 hover:text-brand transition-colors"
          >
            Consulter notre avis vérifié détaillé →
          </a>
        </div>
      </div>
    )}

    <!-- N°2 : Rapport Qualité / Prix -->
    {second && (
      <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
        <div>
          <div class="flex items-center justify-center gap-2 mb-4">
            <span class="text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full whitespace-nowrap">
              🥈 N°2 • Qualité-Prix
            </span>
            <span class="text-xs font-bold text-emerald-800 whitespace-nowrap">
              Compromis Idéal
            </span>
          </div>

          <div class="w-full h-48 bg-slate-50/70 rounded-xl p-3 flex items-center justify-center mb-5 overflow-hidden border border-slate-100">
            <img src={second.data.image_url} alt={second.data.titre} class="w-full h-full object-contain" loading="lazy" />
          </div>

          <h3 class="font-extrabold text-lg sm:text-xl text-slate-900 mb-2 leading-snug !my-0 text-center line-clamp-2">
            <a href={`/avis/${second.id}/`} class="hover:text-brand transition-colors">
              {second.data.titre}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed text-center line-clamp-3 mt-2">
            {second.data.description_courte}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100 space-y-3">
          <BoutonAmazon 
            href={second.data.lien_affiliation} 
            variant="compact"
            texte="Voir le prix Amazon"
            class="w-full"
          />
          <a 
            href={`/avis/${second.id}/`} 
            class="block text-center text-xs font-bold text-slate-600 hover:text-brand transition-colors"
          >
            Lire l'avis complet →
          </a>
        </div>
      </div>
    )}

    <!-- N°3 : Le Choix Expert -->
    {third && (
      <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-all">
        <div>
          <div class="flex items-center justify-center gap-2 mb-4">
            <span class="text-xs font-black uppercase tracking-wider bg-slate-900 text-white px-3 py-1 rounded-full whitespace-nowrap">
              🥉 N°3 • Haut de Gamme
            </span>
            <span class="text-xs font-bold text-slate-700 whitespace-nowrap">
              Finition Supérieure
            </span>
          </div>

          <div class="w-full h-48 bg-slate-50/70 rounded-xl p-3 flex items-center justify-center mb-5 overflow-hidden border border-slate-100">
            <img src={third.data.image_url} alt={third.data.titre} class="w-full h-full object-contain" loading="lazy" />
          </div>

          <h3 class="font-extrabold text-lg sm:text-xl text-slate-900 mb-2 leading-snug !my-0 text-center line-clamp-2">
            <a href={`/avis/${third.id}/`} class="hover:text-brand transition-colors">
              {third.data.titre}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed text-center line-clamp-3 mt-2">
            {third.data.description_courte}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-100 space-y-3">
          <BoutonAmazon 
            href={third.data.lien_affiliation} 
            variant="compact"
            texte="Voir le prix Amazon"
            class="w-full"
          />
          <a 
            href={`/avis/${third.id}/`} 
            class="block text-center text-xs font-bold text-slate-600 hover:text-brand transition-colors"
          >
            Lire l'avis complet →
          </a>
        </div>
      </div>
    )}
  </div>
</section>
