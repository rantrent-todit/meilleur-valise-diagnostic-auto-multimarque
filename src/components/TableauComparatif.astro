---
import BoutonAmazon from './BoutonAmazon.astro';

interface ProductItem {
  id: string;
  data: {
    titre: string;
    description_courte: string;
    image_url: string;
    lien_affiliation: string;
    categories: string[];
  };
}

interface Props {
  produits: ProductItem[];
  titreSection?: string;
  sousTitreSection?: string;
  limit?: number;
}

const { 
  produits = [], 
  titreSection = "Tableau Comparatif : Le Top 3 de la Rédaction",
  sousTitreSection = "Comparaison directe des équipements les plus pertinents selon nos tests vérifiés",
  limit = 3
} = Astro.props;

// Plafond strict : 3 par défaut, maximum 5
const effectiveLimit = Math.min(Math.max(limit, 1), 5);
const produitsAffiches = produits.slice(0, effectiveLimit);
const badgeSelection = produitsAffiches.length <= 3 
  ? "Top 3 Sélection" 
  : `Top ${produitsAffiches.length} Sélection`;
---

<div class="my-12">
  <div class="text-center md:text-left mb-6">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-slate-900 text-white mb-2">
      {badgeSelection}
    </span>
    <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight !my-0">{titreSection}</h2>
    <p class="text-slate-600 text-sm mt-1">{sousTitreSection}</p>
  </div>

  <div class="w-full md:overflow-x-auto pb-4 table-scrollbar">
    <table class="w-full mx-auto block md:table md:min-w-[700px] border-collapse border-spacing-0 md:border-separate md:rounded-2xl md:border md:border-slate-200 bg-transparent md:bg-white shadow-none md:shadow-xs md:overflow-hidden text-left box-border">
      <thead class="hidden md:table-header-group">
        <tr class="hidden md:table-row bg-slate-50 border-b border-slate-200 text-slate-700 text-xs uppercase tracking-wider">
          <th class="hidden md:table-cell py-4 px-5 font-bold border-b border-slate-200 w-1/2">Modèle analysé</th>
          <th class="hidden md:table-cell py-4 px-4 font-bold border-b border-slate-200 text-center w-1/4">Verdict Rédaction</th>
          <th class="hidden md:table-cell py-4 px-4 font-bold border-b border-slate-200 text-center w-1/4">Offre vérifiée</th>
        </tr>
      </thead>
      <tbody class="w-full block space-y-4 md:space-y-0 md:table-row-group md:divide-y md:divide-slate-100 text-sm">
        {produitsAffiches.map((p, idx) => {
          const isWinner = idx === 0;
          const isSecond = idx === 1;
          const isThird = idx === 2;

          return (
            <tr class:list={[
              "w-full flex flex-col bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-5 shadow-xs transition-all box-border md:table-row md:border-0 md:rounded-none md:p-0 md:hover:bg-slate-50/70",
              isWinner ? "border-brand/40 ring-1 ring-brand/20 md:ring-0 md:bg-brand-light" : ""
            ]}>
              <!-- 1. Modèle Analysé : Image + Titre + Lien avis (ordre 2 sur mobile, 1ère colonne sur desktop) -->
              <td class="order-2 w-full box-border block md:table-cell md:order-none py-3 md:py-4 px-0 md:px-5 align-middle">
                <div class="flex items-center gap-3.5">
                  <a href={`/avis/${p.id}/`} class="w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 bg-slate-50/70 border border-slate-100 rounded-xl p-1.5 flex items-center justify-center overflow-hidden hover:opacity-90">
                    <img src={p.data.image_url} alt={p.data.titre} class="w-full h-full object-contain" loading="lazy" />
                  </a>
                  <div class="min-w-0 flex-1">
                    <a href={`/avis/${p.id}/`} class="font-extrabold text-slate-900 hover:text-brand transition-colors text-sm sm:text-base line-clamp-2 leading-snug">
                      {p.data.titre}
                    </a>
                    <a href={`/avis/${p.id}/`} class="text-[11px] font-bold text-slate-500 hover:text-brand transition-colors mt-1 inline-flex items-center gap-1">
                      <span>Lire notre test vérifié complet</span>
                      <span>→</span>
                    </a>
                  </div>
                </div>
              </td>

              <!-- 2. Verdict Rédaction : Badges (ordre 1 sur mobile en haut de la carte, 2e colonne sur desktop) -->
              <td class="order-1 w-full box-border flex items-center justify-start gap-2 pb-2.5 mb-1 border-b border-slate-100 md:table-cell md:order-none md:py-4 md:px-4 md:border-0 md:mb-0 md:text-center align-middle">
                <div>
                  {isWinner && (
                    <div class="flex items-center gap-1.5 md:block">
                      <span class="inline-block px-2.5 py-0.5 bg-brand text-white font-extrabold text-[11px] rounded-full shadow-xs whitespace-nowrap">
                        🏆 Coup de Cœur
                      </span>
                      <span class="text-[10px] font-semibold text-slate-500 md:block md:mt-1 whitespace-nowrap">N°1 de nos tests</span>
                    </div>
                  )}
                  {isSecond && (
                    <div class="flex items-center gap-1.5 md:block">
                      <span class="inline-block px-2.5 py-0.5 bg-emerald-700 text-white font-bold text-[10px] rounded-full whitespace-nowrap">
                        🥈 Rapport Qualité-Prix
                      </span>
                      <span class="text-[10px] font-semibold text-slate-500 md:block md:mt-1 whitespace-nowrap">Meilleur compromis</span>
                    </div>
                  )}
                  {isThird && (
                    <div class="flex items-center gap-1.5 md:block">
                      <span class="inline-block px-2.5 py-0.5 bg-slate-900 text-white font-bold text-[10px] rounded-full whitespace-nowrap">
                        🥉 Choix Haut de Gamme
                      </span>
                      <span class="text-[10px] font-semibold text-slate-500 md:block md:mt-1 whitespace-nowrap">Gamme supérieure</span>
                    </div>
                  )}
                  {!isWinner && !isSecond && !isThird && (
                    <div class="flex items-center gap-1.5 md:block">
                      <span class="inline-block px-2.5 py-0.5 bg-slate-100 text-slate-700 font-bold text-[11px] rounded-md whitespace-nowrap">
                        ⭐ Alternative Recommandée
                      </span>
                      <span class="text-[10px] text-slate-500 md:block md:mt-0.5 whitespace-nowrap">Testé & Validé</span>
                    </div>
                  )}
                </div>
              </td>

              <!-- 3. Offre vérifiée : Bouton Amazon (ordre 3 sur mobile, 3e colonne sur desktop) -->
              <td class="order-3 w-full box-border block md:table-cell md:order-none pt-3 md:py-4 px-0 md:px-4 align-middle text-center border-t border-slate-100 md:border-0">
                <BoutonAmazon 
                  href={p.data.lien_affiliation} 
                  variant={isWinner ? 'primary' : 'compact'}
                  texte="Voir le prix Amazon"
                  sousTexte="Sur Amazon.fr • Stock vérifié"
                  class="w-full md:w-auto md:min-w-[170px] md:max-w-[210px] md:mx-auto"
                />
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>