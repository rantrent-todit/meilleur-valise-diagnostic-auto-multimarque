---
import BoutonAmazon from './BoutonAmazon.astro';

interface ProductItem {
  id: string;
  data: {
    titre: string;
    description_courte: string;
    image_url: string;
    lien_affiliation: string;
    categories: string[];
  };
}

interface Props {
  produits: ProductItem[];
  titreSection?: string;
  sousTitreSection?: string;
  limit?: number;
}

const { 
  produits = [], 
  titreSection = "Tableau Comparatif : Le Top 3 de la Rédaction",
  sousTitreSection = "Comparaison directe des équipements les plus pertinents selon nos tests vérifiés",
  limit = 3
} = Astro.props;

// Plafond strict : 3 par défaut, maximum 5
const effectiveLimit = Math.min(Math.max(limit, 1), 5);
const produitsAffiches = produits.slice(0, effectiveLimit);
const badgeSelection = produitsAffiches.length <= 3 
  ? "Top 3 Sélection" 
  : `Top ${produitsAffiches.length} Sélection`;

function extractSpecs(p: ProductItem) {
  const match = p.data.titre.match(/(\d+x\d+|\d+\s*w|\d+\s*bar|\d+\s*mm)/i);
  if (match) return match[1].toLowerCase();
  if (p.data.categories && p.data.categories.length > 0) return p.data.categories[0];
  return "Matériel testé";
}
---

<div class="my-12">
  <div class="text-center md:text-left mb-6">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-slate-900 text-white mb-2">
      {badgeSelection}
    </span>
    <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight !my-0">{titreSection}</h2>
    <p class="text-slate-600 text-sm mt-1">{sousTitreSection}</p>
  </div>

  <div class="overflow-x-auto pb-4 table-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
    <table class="w-full min-w-[700px] border-separate border-spacing-0 rounded-2xl border border-slate-200 bg-white shadow-xs overflow-hidden text-left">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200 text-slate-700 text-xs uppercase tracking-wider">
          <th class="py-4 px-4 font-bold border-b border-slate-200 w-1/3">Modèle analysé</th>
          <th class="py-4 px-4 font-bold border-b border-slate-200 text-center w-1/6">Usage clé</th>
          <th class="py-4 px-4 font-bold border-b border-slate-200 text-center w-1/5">Verdict Rédaction</th>
          <th class="py-4 px-4 font-bold border-b border-slate-200 text-center w-1/4">Offre vérifiée</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm">
        {produitsAffiches.map((p, idx) => {
          const isWinner = idx === 0;
          const isSecond = idx === 1;
          const isThird = idx === 2;
          const specLabel = extractSpecs(p);

          return (
            <tr class:list={[
              "hover:bg-slate-50/70 transition-colors",
              isWinner ? "bg-orange-50/20" : ""
            ]}>
              <td class="py-4 px-4 align-middle">
                <div class="flex items-center gap-3">
                  <a href={`/avis/${p.id}/`} class="w-16 h-16 flex-shrink-0 bg-white border border-slate-100 rounded-xl p-1.5 flex items-center justify-center overflow-hidden hover:opacity-90">
                    <img src={p.data.image_url} alt={p.data.titre} class="w-full h-full object-contain" loading="lazy" />
                  </a>
                  <div>
                    <a href={`/avis/${p.id}/`} class="font-extrabold text-slate-900 hover:text-orange-600 transition-colors line-clamp-2 leading-tight">
                      {p.data.titre}
                    </a>
                    <a href={`/avis/${p.id}/`} class="text-[11px] font-bold text-slate-500 hover:text-orange-600 transition-colors mt-1 inline-block">
                      Lire notre test vérifié complet →
                    </a>
                  </div>
                </div>
              </td>

              <td class="py-4 px-4 align-middle text-center">
                <span class="inline-block px-2.5 py-1 bg-slate-100 text-slate-800 font-bold rounded-lg text-xs capitalize">
                  {specLabel}
                </span>
              </td>

              <td class="py-4 px-4 align-middle text-center">
                {isWinner && (
                  <div>
                    <span class="inline-block px-3 py-1 bg-orange-600 text-white font-extrabold text-[11px] rounded-full shadow-xs">
                      🏆 Coup de Cœur
                    </span>
                    <span class="block text-[10px] font-semibold text-slate-500 mt-1">N°1 de nos tests</span>
                  </div>
                )}
                {isSecond && (
                  <div>
                    <span class="inline-block px-2.5 py-0.5 bg-emerald-700 text-white font-bold text-[10px] rounded-full">
                      🥈 Rapport Qualité/Prix
                    </span>
                    <span class="block text-[10px] font-semibold text-slate-500 mt-1">Meilleur compromis</span>
                  </div>
                )}
                {isThird && (
                  <div>
                    <span class="inline-block px-2.5 py-0.5 bg-slate-900 text-white font-bold text-[10px] rounded-full">
                      💎 Choix Précision
                    </span>
                    <span class="block text-[10px] font-semibold text-slate-500 mt-1">Gamme supérieure</span>
                  </div>
                )}
                {!isWinner && !isSecond && !isThird && (
                  <div>
                    <span class="inline-block px-2.5 py-0.5 bg-slate-100 text-slate-700 font-bold text-[11px] rounded-md">
                      ⭐ Alternative Recommandée
                    </span>
                    <span class="block text-[10px] text-slate-500 mt-0.5">Testé & Validé</span>
                  </div>
                )}
              </td>

              <td class="py-4 px-4 align-middle text-center">
                <BoutonAmazon 
                  href={p.data.lien_affiliation} 
                  variant={isWinner ? 'primary' : 'compact'}
                  texte="Voir le prix"
                  sousTexte="Sur Amazon.fr"
                  class="w-full"
                />
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>