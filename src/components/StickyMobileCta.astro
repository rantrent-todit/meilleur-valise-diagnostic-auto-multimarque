---
interface Props {
  titre: string;
  image: string;
  lien: string;
}

const { titre, image, lien } = Astro.props;
---

<div 
  id="sticky-mobile-cta" 
  class="fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-gray-200 px-4 py-2.5 shadow-2xl transition-transform duration-300 translate-y-full md:hidden flex items-center justify-between gap-3"
  aria-label="Action rapide"
>
  <div class="flex items-center gap-3 min-w-0">
    <div class="w-12 h-12 flex-shrink-0 bg-white border border-gray-200 rounded-lg p-1 flex items-center justify-center overflow-hidden">
      <img src={image} alt={titre} class="w-full h-full object-contain" loading="lazy" />
    </div>
    <div class="min-w-0">
      <p class="text-xs font-bold text-gray-900 truncate leading-tight">{titre}</p>
      <div class="flex items-center gap-1.5 text-slate-500 text-[11px] font-medium mt-0.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Test vérifié</span>
      </div>
    </div>
  </div>

  <a 
    href={lien}
    target="_blank"
    rel="sponsored nofollow noopener noreferrer"
    class="flex-shrink-0 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-extrabold text-xs px-4 py-2.5 rounded-lg shadow-md flex items-center gap-1.5 active:scale-95 transition-transform"
  >
    <span>Voir prix</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
</div>

<script is:inline>
  // Apparition dynamique après scroll de 300px
  const stickyBar = document.getElementById('sticky-mobile-cta');
  if (stickyBar) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 320) {
        stickyBar.classList.remove('translate-y-full');
      } else {
        stickyBar.classList.add('translate-y-full');
      }
    }, { passive: true });
  }
</script>
